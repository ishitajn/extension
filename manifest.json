{
  "manifest_version": 3,
  "name": "Wingman AI",
  "version": "1.0.0",
  "description": "A conversation co-pilot for dating chats. Provides expert, context-aware suggestions and strategic analysis.",
  "permissions": [
    "storage",
    "geolocation"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.tinder.com/*", "*://*.bumble.com/*"],
      "js": ["content-scraper.js"]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
